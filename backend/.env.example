# --- Database (SQLite file by default; set for Postgres) ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/teampilot

# --- Switch agent-protocol credentials (Nov 4: copy from
#     .switch/agents/teampilot-coordinator.json after registering the
#     coordinator in Switch Console; see docs/SWITCH_INTEGRATION.md) ---
# SWITCH_API_ENDPOINT=
# SWITCH_API_TOKEN=
# SWITCH_AGENT_ID=
# SWITCH_ROOM_ID=

# --- LLM task decomposition (optional; rule-based fallback without it) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Protect mutating API routes (optional in dev) ---
# TEAMPILOT_API_TOKEN=

# Seed the demo workspace on first start (1=yes)
SEED_DEMO=1
